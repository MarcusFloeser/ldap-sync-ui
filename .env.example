# Port der Weboberflaeche auf dem Host
UI_PORT=5000

# Zeitzone fuer Cron-Zeitplaene
TZ=Europe/Zurich

# Optional: erster Benutzer (min. 8 Zeichen Passwort). Wird nur angelegt, solange
# noch kein Benutzer existiert. Leer lassen = Einrichtung im Browser (/setup).
UI_USER=
UI_PASS=

# Optional: fester Schluessel fuer Sitzungen (z.B. mit "openssl rand -hex 32" erzeugen)
SECRET_KEY=

# 1 nur setzen, wenn die Seite ausschliesslich ueber HTTPS erreichbar ist
COOKIE_SECURE=0
# 1 setzen, wenn ein Reverse-Proxy davorsteht
BEHIND_PROXY=0
